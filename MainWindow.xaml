<Window x:Class="TestMethodSettingCardDEMO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestMethodSettingCardDEMO"
        mc:Ignorable="d"
        Title="試驗方法設定 — 互動示範 (TestMethodSettingCardDEMO)"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- 基礎色票與畫刷 -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="BorderNormalBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="PrimaryBlueSoftBrush" Color="#EFF6FF" />
        <SolidColorBrush x:Key="PrimaryBlueBorderBrush" Color="#93C5FD" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <!-- 現代化 TextBox 樣式 -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="SelectionBrush" Value="#93C5FD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 數值輸入框內部無邊框 TextBox 樣式 -->
        <Style x:Key="StepperInnerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="SelectionBrush" Value="#93C5FD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 數值增減小按鈕樣式 -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#60A5FA" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBd" Property="Background" Value="#F8FAFC" />
                                <Setter Property="Foreground" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 現代化 ComboBox 樣式 -->
        <ControlTemplate x:Key="ModernComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Data="M 0,0 L 4.5,4.5 L 9,0"
                          Stroke="#64748B"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateBorder" Property="BorderBrush" Value="#94A3B8" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#1E293B" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateBorder" Property="BorderBrush" Value="#2563EB" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#2563EB" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateBorder" Property="Background" Value="#F1F5F9" />
                    <Setter TargetName="TemplateBorder" Property="BorderBrush" Value="#E2E8F0" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#CBD5E1" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="#1E40AF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ModernComboBoxToggleButton}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Margin="0,4,0,8">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2,3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14"
                                                              ShadowDepth="4"
                                                              Direction="270"
                                                              Color="#0F172A"
                                                              Opacity="0.12" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="0"
                                                      SnapsToDevicePixels="True"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 現代化 CheckBox 樣式 -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowBorder"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,7"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBorder"
                                        Width="18"
                                        Height="18"
                                        CornerRadius="4.5"
                                        Background="#FFFFFF"
                                        BorderBrush="#94A3B8"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Path x:Name="CheckMark"
                                          Data="M 2.5,6.5 L 5.8,9.8 L 12,3.2"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="9,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#2563EB" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="RowBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#BFDBFE" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重設示範按鈕樣式 -->
        <Style x:Key="ResetActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  ShadowDepth="1"
                                                  Direction="270"
                                                  Color="#0F172A"
                                                  Opacity="0.05" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#60A5FA" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 視窗主版面：上方標題與基本資料、中央流程卡片區、底部狀態列 + 最上層無命中測試之拖曳預覽層 -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. 頂部標題列 ==================== -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左側：圖示 + 標題「試驗方法設定」+ 小字「互動示範」 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="9"
                            Background="#2563EB"
                            Margin="0,0,12,0">
                        <Path Data="M 4,14 L 9,14 L 12,7 L 16,19 L 19,11 L 23,11"
                              Stroke="#FFFFFF"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="None" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="試驗方法設定"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center" />
                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    Margin="10,1,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="互動示範"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#2563EB" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="新拉力機軟體 UI 規劃 — 橫向試驗流程卡片編輯與流暢拖曳排序示範"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 右側：重設示範按鈕 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ResetDemoButton"
                            Style="{StaticResource ResetActionButtonStyle}"
                            Click="ResetDemoButton_Click"
                            ToolTip="將所有卡片恢復為初始 1～10 排列順序、預設參數與起始捲動位置">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3,8 A 6,6 0 1 1 5,13.2 M 3,4 L 3,8.5 L 7.5,8.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Margin="0,0,7,0" />
                            <TextBlock Text="重設示範" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. 試驗基本資料區 ==================== -->
        <Border Grid.Row="1"
                Margin="24,16,24,8"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Color="#0F172A"
                                  Opacity="0.04" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <!-- 區塊標籤 -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="基本資料"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1E293B" />
                        <TextBlock Text="Method Metadata"
                                   FontSize="10.5"
                                   Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- 試驗編號 -->
                <Grid Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="試驗編號"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="2,0,0,5" />
                    <TextBox x:Name="TestIdTextBox"
                             Grid.Row="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding BasicInfo.TestId, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 試驗名稱 -->
                <Grid Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="試驗名稱"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="2,0,0,5" />
                    <TextBox x:Name="TestNameTextBox"
                             Grid.Row="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding BasicInfo.TestName, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 荷重輸入來源 -->
                <Grid Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="荷重輸入來源"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="2,0,0,5" />
                    <ComboBox x:Name="LoadSourceComboBox"
                              Grid.Row="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding BasicInfo.LoadSourceOptions}"
                              SelectedItem="{Binding BasicInfo.LoadSource, Mode=TwoWay}" />
                </Grid>

                <!-- 位移輸入來源 -->
                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="位移輸入來源"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="2,0,0,5" />
                    <ComboBox x:Name="StrokeSourceComboBox"
                              Grid.Row="1"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding BasicInfo.StrokeSourceOptions}"
                              SelectedItem="{Binding BasicInfo.StrokeSource, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 3. 中央流程卡片區 ==================== -->
        <Border x:Name="FlowSectionBorder"
                Grid.Row="2"
                Margin="24,8,24,14"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Color="#0F172A"
                                  Opacity="0.04" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 流程區上方小標頭與提示 -->
                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="20,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="#2563EB"
                                    Margin="0,0,10,0" />
                            <TextBlock Text="試驗流程階段卡片"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center" />
                            <Border Background="#E2E8F0"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="共 10 個階段 · 自由排序"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#475569" />
                            </Border>
                        </StackPanel>

                        <!-- 互動操作引導標籤 -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="#EFF6FF"
                                    BorderBrush="#BFDBFE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2,3 A 1.2,1.2 0 1 1 2,5.4 A 1.2,1.2 0 1 1 2,3 M 7,3 A 1.2,1.2 0 1 1 7,5.4 A 1.2,1.2 0 1 1 7,3 M 2,8 A 1.2,1.2 0 1 1 2,10.4 A 1.2,1.2 0 1 1 2,8 M 7,8 A 1.2,1.2 0 1 1 7,10.4 A 1.2,1.2 0 1 1 7,8"
                                          Fill="#2563EB"
                                          VerticalAlignment="Center"
                                          Margin="0,0,7,0" />
                                    <TextBlock Text="按住卡片上方標題把手即可左右拖曳調整順序，靠向左右邊緣可自動水平捲動（Esc 取消）"
                                               FontSize="12"
                                               Foreground="#1E40AF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 單列橫向捲動流程區 -->
                <Grid x:Name="FlowViewportGrid"
                      Grid.Row="1"
                      Background="#F8FAFC"
                      ClipToBounds="True">
                    <ScrollViewer x:Name="FlowScrollViewer"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  Padding="0">
                        <!-- 橫向軌道畫布容器：固定計算總寬度，容納 10 張卡片、9 個方向箭頭與 1 個動態虛線佔位框 -->
                        <Grid x:Name="FlowTrackHost"
                              MinHeight="468"
                              VerticalAlignment="Center"
                              Margin="0,12,0,12">
                            <!-- 層 1：卡片之間的低調流程箭頭（不攔截滑鼠與拖曳） -->
                            <Canvas x:Name="ArrowsCanvas"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="1" />

                            <!-- 層 2：拖曳時的藍色圓角虛線佔位框（全程僅單一實例，不重複出現） -->
                            <Canvas x:Name="PlaceholderCanvas"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="2">
                                <Grid x:Name="DropPlaceholder"
                                      Width="256"
                                      Height="436"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False">
                                    <!-- 圓角虛線背景與邊框（使用 Rectangle Shape 繪製真正的圓角虛線） -->
                                    <Rectangle RadiusX="12"
                                               RadiusY="12"
                                               Fill="#EFF6FF"
                                               Stroke="#3B82F6"
                                               StrokeThickness="2"
                                               StrokeDashArray="5,3"
                                               SnapsToDevicePixels="True" />

                                    <Border CornerRadius="10"
                                            Margin="12"
                                            Background="#66DBEAFE"
                                            BorderBrush="#93C5FD"
                                            BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="16">
                                            <Border Width="48"
                                                    Height="48"
                                                    CornerRadius="24"
                                                    Background="#DBEAFE"
                                                    BorderBrush="#60A5FA"
                                                    BorderThickness="1.5"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,12">
                                                <Path Data="M 12,5 L 12,17 M 7,13 L 12,18 L 17,13 M 5,20 L 19,20"
                                                      Stroke="#2563EB"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="放到這裡"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#1D4ED8"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PlaceholderIndexHintText"
                                                       Text="插入為第 1 步"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3B82F6"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="放開滑鼠左鍵即可完成排序"
                                                       FontSize="11.5"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Canvas>

                            <!-- 層 3：正式流程卡片容器層 -->
                            <Canvas x:Name="CardsCanvas"
                                    Panel.ZIndex="5" />
                        </Grid>
                    </ScrollViewer>

                    <!-- 左右邊緣自動捲動視覺提示漸層（拖曳靠近邊緣時顯示，不攔截命中測試） -->
                    <Border x:Name="LeftAutoScrollIndicator"
                            Width="56"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#442563EB" Offset="0" />
                                <GradientStop Color="#002563EB" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Width="28"
                                Height="56"
                                CornerRadius="0,8,8,0"
                                Background="#D92563EB"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Path Data="M 14,6 L 7,13 L 14,20"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </Border>

                    <Border x:Name="RightAutoScrollIndicator"
                            Width="56"
                            HorizontalAlignment="Right"
                            IsHitTestVisible="False"
                            Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                                <GradientStop Color="#442563EB" Offset="0" />
                                <GradientStop Color="#002563EB" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Width="28"
                                Height="56"
                                CornerRadius="8,0,0,8"
                                Background="#D92563EB"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <Path Data="M 8,6 L 15,13 L 8,20"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 4. 底部簡潔狀態列 ==================== -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左側：即時操作狀態提示 -->
                <Border x:Name="StatusPillBorder"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="7"
                                 Height="7"
                                 Fill="#2563EB"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0" />
                        <TextBlock x:Name="StatusActionText"
                                   Text="拖曳卡片標題可調整順序"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1E40AF"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 中央：目前流程順序即時摘要 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="目前流程順序："
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="FlowSequenceSummaryText"
                               FontSize="12"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右側：快訊操作提示 -->
                <TextBlock Grid.Column="2"
                           Text="提示：欄位數值可直接輸入或點擊 − / + 調整，拖曳後完整保留"
                           FontSize="11.5"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- ==================== 5. 最上層拖曳浮動預覽層（不攔截命中測試） ==================== -->
        <Canvas x:Name="DragOverlayCanvas"
                Grid.Row="0"
                Grid.RowSpan="4"
                Panel.ZIndex="999"
                IsHitTestVisible="False">
            <Border x:Name="DragPreviewBorder"
                    Width="256"
                    Height="436"
                    CornerRadius="12"
                    Background="#FFFFFF"
                    BorderBrush="#2563EB"
                    BorderThickness="2"
                    Opacity="0.93"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DragPreviewScale" ScaleX="1.02" ScaleY="1.02" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="10"
                                      Direction="270"
                                      Color="#0F172A"
                                      Opacity="0.24" />
                </Border.Effect>
                <Grid>
                    <Rectangle x:Name="DragPreviewImageRect"
                               RadiusX="10"
                               RadiusY="10" />
                    <!-- 取消區提示遮罩（當拖曳移出有效區時顯示提示） -->
                    <Border x:Name="DragOutsideWarningBanner"
                            VerticalAlignment="Bottom"
                            Margin="10"
                            CornerRadius="7"
                            Background="#EA991B1B"
                            Padding="10,6"
                            Visibility="Collapsed">
                        <TextBlock Text="位於流程區外 — 放開將取消並還原順序"
                                   Foreground="#FFFFFF"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
